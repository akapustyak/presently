  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "lint": "eslint ./src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint ./src --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier 'src/**/*.{js,jsx,ts,tsx,css,md,json}' --write"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
